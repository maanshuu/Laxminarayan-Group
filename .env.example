# ==============================================================================
# LAXMINARAYAN GROUP — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copy this file to .env:
#      cp .env.example .env
# 2. Fill in your real configuration values.
# 3. NEVER commit your real .env file or real secrets to GitHub!
# ==============================================================================

# Server Network Settings
PORT=5000
NODE_ENV=development
TZ=Asia/Kolkata
FRONTEND_URL=http://localhost:5000,https://localhost:5000

# SQLite Database Location
DB_FILE=./data/laxminarayan.db

# JWT & Authentication Secret (Generate a strong 64+ char random string)
JWT_SECRET=your_super_secret_jwt_random_key_here_min_32_characters

# Default Admin Seed Account
ADMIN_EMAIL=admin@laxminarayangroup.com
ADMIN_PASSWORD=ChangeThisToAStrongPassword2026!

# Fast2SMS OTP Gateway (Optional for SMS OTPs)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# SMTP Email Configuration (Gmail / Corporate SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your_company_email@gmail.com
SMTP_PASS=your_16_char_google_app_password
SMTP_FROM="Laxminarayan Group" <your_company_email@gmail.com>

# WhatsApp Notification Settings
ADMIN_WHATSAPP_PHONE=916352000017

# Meta WhatsApp Business Cloud API (Optional: If empty, 1-click wa.me links are used)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
